# example of file for storing private and user specific environment variables, like keys or system paths
# rename it to ".env" (excluded from version control by default)
# hydra allows you to reference variables in .yaml configs with special syntax: ${oc.env:MY_VAR}

MY_VAR="/home/user/my/system/path"

# --- Paths consumed by editing/AudioEditingCode/code/env.py ----------------------------------
# Repo-relative paths (prompts CSV, edit outputs, temp, lower bound) derive from the repo
# location automatically, so they need no entry here. Only dataset locations differ per server.

# MedleyDB V1 mixes, laid out as <root>/<Track>/<Track>_MIX.wav.
# MEDLEYDB_AUDIO_DIR="/nas/lstanisz/data/medleydb/V1_mix"

# MusicCaps clips, only needed for real-audio-seeded trajectories.
# MUSICCAPS_AUDIO_DIR="/nas/lstanisz/data/musiccaps/audio"

# Override these only to move them off the repo filesystem (defaults live under audio/).
# EDIT_OUTPUTS_DIR="/nas/lstanisz/data/lorainv/outputs/edits"
# MEDLEY_LOWER_BOUND_DIR="/nas/lstanisz/data/lorainv/outputs/medleymd/lower_bound/audios"
# ALDM2_TEMP_DIR="/nas/lstanisz/data/lorainv/.temp/audioldm2"

# Weights & Biases (training)
# WANDB_API_KEY=

# --- PWR / WCSS (lem) ------------------------------------------------------------------------
# Verified template: python-dotenv and `set -a; source .env` agree on every value, and env.py
# derives all six paths from them. Uncomment and drop in as audio/.env on the cluster.
# Check with:  python -m editing.preflight
#
# PROJECT_ROOT=/lustre/pd03/hpc-tomtrz0116-1775130553/lstanisz/code/lorainv
# AUDIO_ROOT=${PROJECT_ROOT}/audio
# DATA_ROOT=/lustre/pd03/hpc-tomtrz0116-1775130553/lstanisz/data
#
# Keep the ~12 GB of weights on lustre, not $HOME; warm it on a login node with
# editing/AudioEditingCode/code/slurm_scripts/wcss/prefetch_models.py
# HF_HOME=${PROJECT_ROOT}/.cache/huggingface
# HF_TOKEN=                       # REQUIRED: Stable Audio Open 1.0 is license-gated
#
# REQUIRED. Layout must be <root>/<Track>/<Track>_MIX.wav (35 MusicDelta tracks, 358 MiB).
# MEDLEYDB_AUDIO_DIR=${DATA_ROOT}/medleydb/V1_mix
#
# Outputs: leave these unset so everything lands together under audio/outputs/ --
# edits, the paired reference, and the slurm logs, which already go there. On WCSS the repo
# is on lustre anyway, and keeping one tree means pwr-mount can see the results.
# audio/.gitignore already covers outputs/ and .temp.
#
# Only override them to put outputs on a different filesystem from the repo:
# EDIT_OUTPUTS_DIR=${DATA_ROOT}/lorainv/outputs/edits
# ALDM2_TEMP_DIR=${DATA_ROOT}/lorainv/.temp/audioldm2
# MEDLEY_LOWER_BOUND_DIR=${DATA_ROOT}/lorainv/outputs/medleymd/lower_bound_full/audios
#
# If you override one, override all three -- a half-moved layout is how the reference ended up
# somewhere the eval did not look.
#
# HPC_PWR_ACCOUNT=hpc-tomtrz0116-1775130553
# HPC_PWR_PARTITION=lem-gpu-short
#
# LoRA training reads these; src/inversion_lora/train.py calls load_dotenv on audio/.env.
# lem nodes have internet, so wandb_mode=online works directly. Use offline + `wandb sync`
# only if a node turns out to be firewalled.
# WANDB_API_KEY=
# WANDB_PROJECT=audio-inversion-lora
