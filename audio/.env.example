# =============================================================================
# audio/.env -- the single place configuration is edited.
#
# env.py loads this with override=True, so these values beat anything already
# exported in the shell or inherited by a SLURM job. Declare every key you care
# about here: a key that is NOT listed falls back to env.py's default, and a
# stale export of that same name would then win. That is exactly how an eval run
# once read edits from a directory nobody had written to.
#
# The ONLY setting that belongs outside this file is HF_TOKEN, which is a secret
# and lives in ~/.bashrc. env.py never declares it, so the shell value is used.
#
# Sourced by the slurm scripts as `set -a; source .env; set +a`, and read by
# env.py with python-dotenv. Both expand ${VAR}, and both strip inline comments.
#
# Check what is actually in effect, and where each value came from:
#   python editing/AudioEditingCode/code/env.py
# =============================================================================

# ── Root ───────────────────────────────────────────────────────────────────
# The repo checkout: the directory that contains audio/. Used only to interpolate
# the paths below. env.py checks it matches the checkout it lives in and refuses
# to import if not, so a .env copied from another machine fails immediately
# instead of silently pointing every path somewhere that does not exist.
PROJECT_ROOT=/lustre/pd03/hpc-tomtrz0116-1775130553/lstanisz/code/lorainv

# ── Hugging Face ───────────────────────────────────────────────────────────
# Keep the ~12 GB of weights off $HOME. Warm it on a login node with
#   python editing/AudioEditingCode/code/slurm_scripts/wcss/prefetch_models.py
HF_HOME=${PROJECT_ROOT}/.cache/huggingface
# HF_TOKEN is NOT set here -- it comes from ~/.bashrc.

# ── Datasets ───────────────────────────────────────────────────────────────
# MedleyDB V1 mixes, laid out as <root>/<Track>/<Track>_MIX.wav.
MEDLEYDB_AUDIO_DIR=${PROJECT_ROOT}/audio/data/medleydb/V1_mix

# Prompt CSV. captions_gpt5.csv is the full 696-row benchmark and the only one
# with all four driver columns. The hparam/test/loc splits live beside it --
# if you switch this, switch MEDLEY_LOWER_BOUND_DIR to the matching split too,
# or the paired metrics silently degrade.
MEDLEY_PROMPTS_CSV=${PROJECT_ROOT}/audio/editing/AudioEditingCode/MedleyMDPrompts/captions_gpt5.csv

# MusicCaps clips: only needed for real-audio-seeded inversion trajectories.
MUSICCAPS_AUDIO_DIR=${PROJECT_ROOT}/audio/data/musiccaps/audio

# ── Outputs (one tree, so results, reference and logs stay together) ───────
EDIT_OUTPUTS_DIR=${PROJECT_ROOT}/audio/outputs/edits
MEDLEY_LOWER_BOUND_DIR=${PROJECT_ROOT}/audio/outputs/medleymd/lower_bound_full/audios
ALDM2_TEMP_DIR=${PROJECT_ROOT}/audio/.temp/audioldm2

# ── Slurm (PWR / WCSS lem) ─────────────────────────────────────────────────
HPC_PWR_ACCOUNT=hpc-tomtrz0116-1775130553
HPC_PWR_PARTITION=lem-gpu-short

# ── Training (LoRA inversion) ──────────────────────────────────────────────
WANDB_PROJECT=audio-inversion-lora
# WANDB_API_KEY=
